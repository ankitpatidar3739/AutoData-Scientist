# LLM API Configuration (Optional: system works with Gemini, OpenAI-compatible APIs, or built-in heuristic/expert rules mode)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Sandbox Settings
SANDBOX_TIMEOUT_SECONDS=180
MAX_SELF_HEALING_RETRIES=3

# ML Execution Settings
DEVICE=cpu
DEFAULT_RANDOM_SEED=42
